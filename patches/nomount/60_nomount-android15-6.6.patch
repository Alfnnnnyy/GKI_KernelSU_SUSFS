+# Makefile for NoMount
+
+NM_REAL_PATH := $(shell readlink -f $(src))
+NOMOUNT_COMMITS := $(shell git -C $(NM_REAL_PATH) rev-list --count HEAD 2>/dev/null)
+ifneq ($(NOMOUNT_COMMITS),)
